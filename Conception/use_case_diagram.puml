@startuml
left to right direction
actor "Reader" as R
actor "Author" as A
actor "Admin" as D

rectangle BlogSystem {
  usecase "View Articles" as UC1
  usecase "Read Article" as UC2
  usecase "Register" as UC3
  usecase "Login" as UC4
  usecase "Comment on Article" as UC5
  usecase "Like Article" as UC6
  usecase "Create Article" as UC7
  usecase "Edit Own Article" as UC8
  usecase "Delete Own Article" as UC9
  usecase "Manage Categories" as UC10
  usecase "Manage Users" as UC11
  usecase "Manage All Articles" as UC12
}

R -- UC1
R -- UC2
R -- UC3
R -- UC4
R -- UC5
R -- UC6

A --|> R
A -- UC7
A -- UC8
A -- UC9

D --|> A
D -- UC10
D -- UC11
D -- UC12
@enduml
